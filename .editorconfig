root = true

# Project text files are UTF-8. On Windows PowerShell, always read/write with
# explicit -Encoding UTF8 to avoid mojibake in Chinese project documents.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{ps1,psm1,psd1}]
charset = utf-8
