# Copy this file to .env in the package root and replace every CHANGE_ME value.
# The bundled Compose profile is for an isolated single-host installation.
EXAMINE_DB_NAME=examine2
EXAMINE_DB_USERNAME=examine
EXAMINE_DB_PASSWORD=CHANGE_ME_DB_PASSWORD_MIN_16
EXAMINE_DB_ROOT_PASSWORD=CHANGE_ME_DB_ROOT_PASSWORD_MIN_16
EXAMINE_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_MIN_16
EXAMINE_BOOTSTRAP_ROOT_USERNAME=examine_root
EXAMINE_BOOTSTRAP_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD_MIN_16
EXAMINE_BOOTSTRAP_ROOT_DISPLAY_NAME=Examine2 Root
EXAMINE_DATA_ROOT=CHANGE_ME_ABSOLUTE_DATA_ROOT
EXAMINE_WEB_BIND=127.0.0.1
EXAMINE_WEB_PORT=8088
EXAMINE_BACKEND_BIND=127.0.0.1
EXAMINE_BACKEND_PORT=8080
EXAMINE_DEPLOYMENT_MODE=LOCAL
EXAMINE_SECURE_COOKIES=false

# Optional integration settings. Keep secrets in the deployment secret manager.
EXAMINE_ACCOUNT_RECOVERY_MAIL_ENABLED=false
EXAMINE_EVENT_SMTP_ENABLED=false
EXAMINE_EVENT_WEBHOOK_ENABLED=false
EXAMINE_FILE_STORAGE_MODE=LOCAL
EXAMINE_DATASOURCE_JDBC_ALLOWED_TARGETS=
