<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.unique.unexamine.moduleconfig.base.mapper.ModuleVersionMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.unique.unexamine.moduleconfig.base.entity.ModuleVersion">
        <id column="id" property="id" />
        <result column="module_id" property="moduleId" />
        <result column="version_number" property="versionNumber" />
        <result column="snapshot_json" property="snapshotJson" />
        <result column="published_by_account_id" property="publishedByAccountId" />
        <result column="published_time" property="publishedTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, module_id, version_number, snapshot_json, published_by_account_id, published_time
    </sql>

</mapper>
