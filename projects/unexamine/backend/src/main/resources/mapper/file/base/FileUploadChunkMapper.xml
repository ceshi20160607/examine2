<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.unique.unexamine.file.base.mapper.FileUploadChunkMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.unique.unexamine.file.base.entity.FileUploadChunk">
        <id column="id" property="id" />
        <result column="upload_session_id" property="uploadSessionId" />
        <result column="chunk_number" property="chunkNumber" />
        <result column="byte_offset" property="byteOffset" />
        <result column="size_bytes" property="sizeBytes" />
        <result column="sha256" property="sha256" />
        <result column="status" property="status" />
        <result column="created_time" property="createdTime" />
        <result column="completed_time" property="completedTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, upload_session_id, chunk_number, byte_offset, size_bytes, sha256, `status`, created_time, completed_time
    </sql>

</mapper>
