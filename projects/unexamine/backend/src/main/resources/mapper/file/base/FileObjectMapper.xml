<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.unique.unexamine.file.base.mapper.FileObjectMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.unique.unexamine.file.base.entity.FileObject">
        <id column="id" property="id" />
        <result column="system_id" property="systemId" />
        <result column="tenant_id" property="tenantId" />
        <result column="storage_key" property="storageKey" />
        <result column="original_name" property="originalName" />
        <result column="content_type" property="contentType" />
        <result column="size_bytes" property="sizeBytes" />
        <result column="sha256_hex" property="sha256Hex" />
        <result column="status" property="status" />
        <result column="created_by_account_id" property="createdByAccountId" />
        <result column="create_time" property="createTime" />
        <result column="delete_time" property="deleteTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, system_id, tenant_id, storage_key, original_name, content_type, size_bytes, sha256_hex, `status`, created_by_account_id, create_time, delete_time
    </sql>

</mapper>
