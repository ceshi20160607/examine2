<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.unique.unexamine.flow.base.mapper.FlowVersionMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.unique.unexamine.flow.base.entity.FlowVersion">
        <id column="id" property="id" />
        <result column="flow_id" property="flowId" />
        <result column="version_number" property="versionNumber" />
        <result column="draft_revision" property="draftRevision" />
        <result column="definition_hash" property="definitionHash" />
        <result column="snapshot_json" property="snapshotJson" />
        <result column="simulation_result_json" property="simulationResultJson" />
        <result column="change_summary" property="changeSummary" />
        <result column="published_by_account_id" property="publishedByAccountId" />
        <result column="published_at" property="publishedAt" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, flow_id, version_number, draft_revision, definition_hash, snapshot_json, simulation_result_json, change_summary, published_by_account_id, published_at
    </sql>

</mapper>
