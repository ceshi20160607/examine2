<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.unique.unexamine.application.base.mapper.AppCredentialMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.unique.unexamine.application.base.entity.AppCredential">
        <id column="id" property="id" />
        <result column="application_id" property="applicationId" />
        <result column="credential_version" property="credentialVersion" />
        <result column="client_id" property="clientId" />
        <result column="secret_hash" property="secretHash" />
        <result column="signing_secret_ref" property="signingSecretRef" />
        <result column="secret_hint" property="secretHint" />
        <result column="valid_start_time" property="validStartTime" />
        <result column="expire_time" property="expireTime" />
        <result column="status" property="status" />
        <result column="revoke_time" property="revokeTime" />
        <result column="created_by_account_id" property="createdByAccountId" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, application_id, credential_version, client_id, secret_hash, signing_secret_ref, secret_hint, valid_start_time, expire_time, `status`, revoke_time, created_by_account_id, create_time
    </sql>

</mapper>
