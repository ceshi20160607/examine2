<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.unique.unexamine.platform.base.mapper.PlatformAccountCredentialMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.unique.unexamine.platform.base.entity.PlatformAccountCredential">
        <id column="id" property="id" />
        <result column="account_id" property="accountId" />
        <result column="password_hash" property="passwordHash" />
        <result column="credential_version" property="credentialVersion" />
        <result column="changed_at" property="changedAt" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, account_id, password_hash, credential_version, changed_at
    </sql>

</mapper>
