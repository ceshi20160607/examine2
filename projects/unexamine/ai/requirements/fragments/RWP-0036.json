{"schemaVersion":1,"source":{"planPath":"../analysis-plan.json","planSha256":"ad195f56ec3162f4f80307949d8e01c74cbfed2a57d7e2f5460bf998a7353192"},"packetId":"RWP-0036","requirements":[{"id":"REQ-AI-MODEL-AUTHORIZATION","title":"平台模型授权与系统 Agent 策略","statement":"平台配置本地或外部模型供应商、模型、地址、密钥、额度、并发、脱敏、数据出境和授权系统；系统管理员配置 Agent 可访问模块、字段、动作、数据范围和确认策略，平台 Agent 不得绕过系统成员权限。","type":"functional","priority":"must","origin":"explicit","status":"confirmed","sourceBlocks":["B0243","B0244","B0245","B0246","B0247","B0248","B0249"],"acceptanceCriteria":["模型密钥安全保存且按平台授权分配到系统。","系统 Agent 每次运行绑定策略版本、当前成员权限和脱敏规则。","平台 Agent 需要业务数据时先引导切换系统，不能携带系统业务写入负载。"],"decisionIds":[]},{"id":"REQ-AI-CONTEXT-ENTRIES","title":"平台、系统、配置、详情和工作 Agent 入口","statement":"平台主页面、系统运行态、系统后台、业务详情和任务分别提供符合上下文的 Agent，支持平台信息、业务查询、配置草稿、当前记录总结和任务/日志辅助，但每个入口只处理授权范围。","type":"functional","priority":"must","origin":"explicit","status":"confirmed","sourceBlocks":["B0250","B0251"],"acceptanceCriteria":["不同入口展示明确 Agent 身份和作用范围。","详情 Agent 只读取当前记录权限数据，工作 Agent 只在用户主动操作时提供候选内容。"],"decisionIds":[]},{"id":"REQ-AI-CONFIRMED-WRITE","title":"结构化识别和人工确认写入","statement":"Agent 根据对话生成模块字段、页面、Flow 草稿、打印导出配置或业务写入前必须展示目标系统模块、字段映射、关联、附件、负责人、时间、标签和置信度，低置信度要求补充，确认前不得写入且不能绕过校验权限。","type":"functional","priority":"must","origin":"explicit","status":"confirmed","sourceBlocks":["B0252","B0253","B0254"],"acceptanceCriteria":["用户确认后才执行写入并可从结果追溯原始对话、确认人、模型和提示词版本。","取消确认不会产生业务数据、Flow 或配置草稿。","必填、唯一、Flow 前置和权限失败返回具体字段或规则。"],"decisionIds":[]}],"decisions":[],"coverage":[{"sourceBlock":"B0243","classification":"requirement","requirementIds":["REQ-AI-MODEL-AUTHORIZATION"],"rationale":"智能能力总约束。"},{"sourceBlock":"B0244","classification":"context","requirementIds":[],"rationale":"智能能力目录引导语。"},{"sourceBlock":"B0245","classification":"requirement","requirementIds":["REQ-AI-MODEL-AUTHORIZATION","REQ-AI-CONFIRMED-WRITE"],"rationale":"智能能力目录。"},{"sourceBlock":"B0246","classification":"context","requirementIds":[],"rationale":"平台 Agent 引导语。"},{"sourceBlock":"B0247","classification":"requirement","requirementIds":["REQ-AI-MODEL-AUTHORIZATION"],"rationale":"平台模型与 Agent 规则。"},{"sourceBlock":"B0248","classification":"context","requirementIds":[],"rationale":"系统 Agent 引导语。"},{"sourceBlock":"B0249","classification":"requirement","requirementIds":["REQ-AI-MODEL-AUTHORIZATION","REQ-AI-CONFIRMED-WRITE"],"rationale":"系统 Agent 权限和确认。"},{"sourceBlock":"B0250","classification":"context","requirementIds":[],"rationale":"运行入口引导语。"},{"sourceBlock":"B0251","classification":"requirement","requirementIds":["REQ-AI-CONTEXT-ENTRIES"],"rationale":"Agent 上下文入口。"},{"sourceBlock":"B0252","classification":"context","requirementIds":[],"rationale":"对话录入引导语。"},{"sourceBlock":"B0253","classification":"requirement","requirementIds":["REQ-AI-CONFIRMED-WRITE"],"rationale":"结构化识别和确认规则。"},{"sourceBlock":"B0254","classification":"requirement","requirementIds":["REQ-AI-CONFIRMED-WRITE"],"rationale":"对话写入边界。"}]}
