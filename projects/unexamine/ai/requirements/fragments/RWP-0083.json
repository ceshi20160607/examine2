{"schemaVersion":1,"source":{"planPath":"../analysis-plan.json","planSha256":"ad195f56ec3162f4f80307949d8e01c74cbfed2a57d7e2f5460bf998a7353192"},"packetId":"RWP-0083","requirements":[{"id":"REQ-KPI-CLOSED-LOOP","title":"KPI 目标、模块数据汇总和未达标提醒","statement":"KPI 可按人员、部门或角色设置月、季度或年目标，从指定模块字段按权限与规则汇总实际值，计算达成率，在目标看板展示并对未达标对象提醒，覆盖金额、按时完成率和任务完成数等指标。","type":"functional","priority":"must","origin":"explicit","status":"confirmed","sourceBlocks":["B0494","B0495","B0496","B0497","B0498"],"acceptanceCriteria":["目标配置明确对象、周期、模块、字段、聚合方式、过滤条件和目标值。","合同金额、工单按时率和项目任务数示例均能从模块数据计算并下钻来源记录。","看板和提醒只使用当前授权数据，周期或源数据变化后重新计算达成率。","未达标提醒按配置接收人和时间发送且可追踪处理。"],"decisionIds":[]}],"decisions":[],"coverage":[{"sourceBlock":"B0494","classification":"requirement","requirementIds":["REQ-KPI-CLOSED-LOOP"],"rationale":"KPI 与模块数据闭环。"},{"sourceBlock":"B0495","classification":"context","requirementIds":[],"rationale":"必需能力引导语。"},{"sourceBlock":"B0496","classification":"requirement","requirementIds":["REQ-KPI-CLOSED-LOOP"],"rationale":"目标对象、周期、来源、计算、看板和提醒。"},{"sourceBlock":"B0497","classification":"context","requirementIds":[],"rationale":"KPI 场景引导语。"},{"sourceBlock":"B0498","classification":"requirement","requirementIds":["REQ-KPI-CLOSED-LOOP"],"rationale":"金额、按时率和完成数场景。"}]}
