{"schemaVersion":1,"source":{"planPath":"../analysis-plan.json","planSha256":"ad195f56ec3162f4f80307949d8e01c74cbfed2a57d7e2f5460bf998a7353192"},"packetId":"RWP-0019","requirements":[{"id":"REQ-MODULE-FIELD-TYPES","title":"完整低代码字段类型目录","statement":"模块字段必须覆盖文本、号码、数值金额、日期时间、选择、人员部门组织、附件图片文件、编号、关联引用子表、地址位置、评分进度标签、条码签名富文本 JSON 密钥状态系统字段，以及公式、汇总、计算、查找、聚合和受控 AI 填充等高级类型。","type":"functional","priority":"must","origin":"explicit","status":"confirmed","sourceBlocks":["B0104","B0105","B0106","B0107"],"acceptanceCriteria":["字段设计器可以创建目录内每种字段并在表单、详情和列表按类型正确展示。","AI 填充字段只有在模型授权、数据权限和人工确认后写入。"],"decisionIds":[]},{"id":"REQ-MODULE-FIELD-CONFIG","title":"按字段类型配置校验、显示、权限和数据规则","statement":"字段配置必须覆盖名称编码类型、必填默认提示排序、显隐只读、搜索筛选列表详情、权限、关联子表、选项、校验默认值、条件显示、列表导出脱敏、索引唯一历史和移动展示，并按字段类型显示专属配置。","type":"functional","priority":"must","origin":"explicit","status":"confirmed","sourceBlocks":["B0108","B0109","B0110","B0111","B0112","B0113"],"acceptanceCriteria":["金额、人员、关联、公式和子表字段分别显示专属配置与即时校验。","关联保存目标 ID、展示主要字段，子表以一主多明细事务保存。","自动编号并发下唯一且连续策略可追踪。","删除字段默认停用并保留历史值和显示快照。"],"decisionIds":[]}],"decisions":[],"coverage":[{"sourceBlock":"B0104","classification":"context","requirementIds":[],"rationale":"字段类型引导语。"},{"sourceBlock":"B0105","classification":"requirement","requirementIds":["REQ-MODULE-FIELD-TYPES"],"rationale":"基础字段目录。"},{"sourceBlock":"B0106","classification":"context","requirementIds":[],"rationale":"高级字段引导语。"},{"sourceBlock":"B0107","classification":"requirement","requirementIds":["REQ-MODULE-FIELD-TYPES"],"rationale":"高级字段目录。"},{"sourceBlock":"B0108","classification":"context","requirementIds":[],"rationale":"字段配置引导语。"},{"sourceBlock":"B0109","classification":"requirement","requirementIds":["REQ-MODULE-FIELD-CONFIG"],"rationale":"字段配置完整目录。"},{"sourceBlock":"B0110","classification":"context","requirementIds":[],"rationale":"关联字段引导语。"},{"sourceBlock":"B0111","classification":"requirement","requirementIds":["REQ-MODULE-FIELD-CONFIG"],"rationale":"关联和子表语义。"},{"sourceBlock":"B0112","classification":"context","requirementIds":[],"rationale":"交互优化引导语。"},{"sourceBlock":"B0113","classification":"requirement","requirementIds":["REQ-MODULE-FIELD-CONFIG"],"rationale":"设计器、编号、停用和专属配置约束。"}]}
