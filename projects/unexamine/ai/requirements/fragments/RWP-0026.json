{"schemaVersion":1,"source":{"planPath":"../analysis-plan.json","planSha256":"ad195f56ec3162f4f80307949d8e01c74cbfed2a57d7e2f5460bf998a7353192"},"packetId":"RWP-0026","requirements":[{"id":"REQ-AUTHORIZATION-MODEL","title":"平台到字段数据的统一授权模型","statement":"权限覆盖平台、系统、应用、菜单、页面、动作、字段、数据和应用访问；动作至少含查看新增编辑删除导入导出审批转办终止配置，数据范围支持全部、本人、部门、部门下级、指定部门成员及字段规则。","type":"functional","priority":"must","origin":"explicit","status":"confirmed","sourceBlocks":["B0163","B0164","B0165","B0166","B0167","B0168"],"acceptanceCriteria":["角色授权可以用中文矩阵配置并预览最终用户权限。","每个模块动作独立计算数据范围，字段查看编辑导出分别校验。","有效角色权限按规则合并后用于菜单、按钮和后端查询写入。"],"decisionIds":[]},{"id":"REQ-AUTHORIZATION-ENFORCEMENT","title":"前后端一致且后端兜底授权","statement":"前端菜单按钮和页面状态必须与后端权限一致，后端始终执行最终校验；权限变化后相关缓存及时失效，角色权限可复制但保留目标上下文校验。","type":"quality","priority":"must","origin":"explicit","status":"confirmed","sourceBlocks":["B0169","B0170"],"acceptanceCriteria":["隐藏按钮对应接口在无权限直接调用时仍拒绝。","角色权限修改后新请求立即按新权限执行。","复制权限不会复制跨系统或跨租户无效资源。"],"decisionIds":[]}],"decisions":[],"coverage":[{"sourceBlock":"B0163","classification":"context","requirementIds":[],"rationale":"权限范围引导语。"},{"sourceBlock":"B0164","classification":"requirement","requirementIds":["REQ-AUTHORIZATION-MODEL"],"rationale":"权限层级目录。"},{"sourceBlock":"B0165","classification":"context","requirementIds":[],"rationale":"操作权限引导语。"},{"sourceBlock":"B0166","classification":"requirement","requirementIds":["REQ-AUTHORIZATION-MODEL"],"rationale":"操作权限目录。"},{"sourceBlock":"B0167","classification":"context","requirementIds":[],"rationale":"数据范围引导语。"},{"sourceBlock":"B0168","classification":"requirement","requirementIds":["REQ-AUTHORIZATION-MODEL"],"rationale":"数据范围目录。"},{"sourceBlock":"B0169","classification":"context","requirementIds":[],"rationale":"优化能力引导语。"},{"sourceBlock":"B0170","classification":"requirement","requirementIds":["REQ-AUTHORIZATION-ENFORCEMENT"],"rationale":"授权执行和缓存要求。"}]}
