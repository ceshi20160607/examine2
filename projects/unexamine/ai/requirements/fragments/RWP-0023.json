{"schemaVersion":1,"source":{"planPath":"../analysis-plan.json","planSha256":"ad195f56ec3162f4f80307949d8e01c74cbfed2a57d7e2f5460bf998a7353192"},"packetId":"RWP-0023","requirements":[{"id":"REQ-DASHBOARD-DATA-COMPONENTS","title":"仪表盘数据、组件与配置","statement":"仪表盘可读取当前系统单模块、多模块、自定义数据源、Flow 待办、KPI、导入导出任务和应用调用数据；组件支持单值、筛选、分组、趋势、排名、列表、待办和 KPI，并配置字段、统计方式、条件、时间、分组、排序、数量、刷新、权限和跳转。","type":"functional","priority":"must","origin":"explicit","status":"confirmed","sourceBlocks":["B0141","B0142","B0143","B0144","B0145","B0146","B0147","B0148"],"acceptanceCriteria":["不同业务场景可通过配置组合首页，不增加写死页面。","组件统计口径、过滤条件和跳转目标可预览并在发布后读回一致结果。"],"decisionIds":[]},{"id":"REQ-VISUAL-PAGE-DESIGN","title":"可视化页面与仪表盘设计","statement":"页面设计以实时可视化为主要编辑方式，支持复制、发布、仪表盘拖拽布局和尺寸、个人与公共视图及统计下钻；JSON 只作为高级导入导出或诊断。","type":"functional","priority":"must","origin":"explicit","status":"confirmed","sourceBlocks":["B0149","B0150"],"acceptanceCriteria":["管理员无需编辑 JSON 即可完成布局、预览和发布。","发布前运行态保持旧版本，发布成功后切换到新版本。"],"decisionIds":[]},{"id":"REQ-CONFIGURABLE-DATA-SOURCE","title":"统计查询数据源定义","statement":"数据源不是业务模块，而是把授权模块数据配置为可查询视图，供仪表盘、统计、KPI、打印、导出和 AI 使用。","type":"functional","priority":"must","origin":"explicit","status":"confirmed","sourceBlocks":["B0151","B0152"],"acceptanceCriteria":["数据源有独立配置和发布版本但不出现在普通业务模块导航。","每次查询继续执行输出字段、系统租户和数据权限。"],"decisionIds":[]}],"decisions":[],"coverage":[{"sourceBlock":"B0141","classification":"context","requirementIds":[],"rationale":"仪表盘数据来源引导语。"},{"sourceBlock":"B0142","classification":"requirement","requirementIds":["REQ-DASHBOARD-DATA-COMPONENTS"],"rationale":"仪表盘数据来源目录。"},{"sourceBlock":"B0143","classification":"context","requirementIds":[],"rationale":"组件类型引导语。"},{"sourceBlock":"B0144","classification":"requirement","requirementIds":["REQ-DASHBOARD-DATA-COMPONENTS"],"rationale":"组件类型目录。"},{"sourceBlock":"B0145","classification":"context","requirementIds":[],"rationale":"配置项引导语。"},{"sourceBlock":"B0146","classification":"requirement","requirementIds":["REQ-DASHBOARD-DATA-COMPONENTS"],"rational