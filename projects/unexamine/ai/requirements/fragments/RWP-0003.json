{"schemaVersion":1,"source":{"planPath":"../analysis-plan.json","planSha256":"ad195f56ec3162f4f80307949d8e01c74cbfed2a57d7e2f5460bf998a7353192"},"packetId":"RWP-0003","requirements":[{"id":"REQ-PRODUCT-GOALS","title":"平台核心使用目标","statement":"管理员能配置系统能力，普通用户能在授权系统使用模块，内外访问方能通过应用安全调用，项目能稳定部署升级维护。","type":"functional","priority":"must","origin":"explicit","status":"confirmed","sourceBlocks":["B0010"],"acceptanceCriteria":["管理员、普通用户、应用调用方和运维人员分别有真实入口完成对应目标。"],"decisionIds":[]},{"id":"REQ-CONFIGURABLE-BUSINESS-SCENARIOS","title":"通过通用能力组合业务场景","statement":"客户、合同、订单、项目、任务、审批、资产、工单、巡检、台账及轻量 CRM/OA/进销存/ERP/MES/售后场景必须由通用模块、字段、子表、Flow、规则、KPI、打印和仪表盘能力组合，不建设重型行业套件。","type":"functional","priority":"must","origin":"explicit","status":"confirmed","sourceBlocks":["B0013","B0015"],"acceptanceCriteria":["管理员可以用同一套低代码能力配置至少一种台账场景和一种带 Flow 的业务场景。","产品中不出现独立重型 ERP 或 MES 套件。"],"decisionIds":[]},{"id":"REQ-ADMIN-NO-CODE-JOURNEY","title":"管理员无代码建模旅程","statement":"不会写代码的管理员必须能按系统、模块组、模块、字段、动作、菜单发布、权限、Flow、可选应用、成员和导出顺序完成系统搭建。","type":"functional","priority":"must","origin":"explicit","status":"confirmed","sourceBlocks":["B0017","B0018","B0019"],"acceptanceCriteria":["从系统后台真实页面完成完整建模并发布后，授权用户在运行态看到模块组和模块。","应用不成为模块父级。"],"decisionIds":[]},{"id":"REQ-END-USER-BUSINESS-JOURNEY","title":"普通用户业务旅程","statement":"普通用户必须能登录并进入授权系统，使用模块菜单完成增改查筛选、详情、附件、审批、消息和权限内导出。","type":"functional","priority":"must","origin":"explicit","status":"confirmed","sourceBlocks":["B0020","B0021"],"acceptanceCriteria":["页面旅程逐步验证登录、进入系统、新建业务数据、列表首行读回、详情、附件、审批、消息和导出权限。"],"decisionIds":[]}],"decisions":[],"coverage":[{"sourceBlock":"B0010","classification":"requirement","requirementIds":["REQ-PRODUCT-GOALS"],"rationale":"总体目标。"},{"sourceBlock":"B0012","classification":"context","requirementIds":[],"rationale":"覆盖范围引导语。"},{"sourceBlock":"B0013","classification":"requirement","requirementIds":["REQ-CONFIGURABLE-BUSINESS-SCENARIOS"],"rationale":"可组合场景目录。"},{"sourceBlock":"B0014","classification":"context","requirementIds":[],"rationale":"说明引导语。"},{"sourceBlock":"B0015","classification":"requirement","requirementIds":["REQ-CONFIGURABLE-BUSINESS-SCENARIOS"],"rationale":"轻量场景边界。"},{"sourceBlock":"B0017","classification":"requirement","requirementIds":["REQ-ADMIN-NO-CODE-JOURNEY"],"rationale":"管理员角色前提。"},{"sourceBlock":"B0018","classification":"requirement","requirementIds":["REQ-ADMIN-NO-CODE-JOURNEY"],"rationale":"管理员完整旅程。"},{"sourceBlock":"B0019","classification":"requirement","requirementIds":["REQ-ADMIN-NO-CODE-JOURNEY"],"rationale":"建模边界。"},{"sourceBlock":"B0020","classification":"requirement","requirementIds":["REQ-END-USER-BUSINESS-JOURNEY"],"rationale":"普通用户角色前提。"},{"sourceBlock":"B0021","classification":"requirement","requirementIds":["REQ-END-USER-BUSINESS-JOURNEY"],"rationale":"普通用户完整旅程。"}]}
