{
  "schemaVersion": 1,
  "pathBase": "workspace",
  "assignments": [
    {
      "id": "LEAD-001",
      "role": "lead",
      "status": "in_progress",
      "task": "维护唯一需求源、任务依赖、决策、当前事实状态和后续周期排期",
      "allowedPaths": [
        "projects/unexamine/ai"
      ],
      "inputs": [
        "docs/user_requirement.md",
        "projects/unexamine/ai/agents/assignments.json"
      ],
      "outputs": [
        "projects/unexamine/ai/status/project-status.json"
      ],
      "blockedBy": []
    },
    {
      "id": "REQ-001",
      "role": "requirements",
      "status": "in_progress",
      "task": "完整分析 117 个互斥需求包，合并为无重复的原子需求、验收条件、待决问题和任务输入",
      "allowedPaths": [
        "projects/unexamine/ai/requirements",
        "projects/unexamine/ai/decisions",
        "projects/unexamine/ai/status"
      ],
      "inputs": [
        "docs/user_requirement.md",
        "projects/unexamine/ai/requirements/requirement-intake.json",
        "projects/unexamine/ai/requirements/analysis-plan.json"
      ],
      "outputs": [
        "projects/unexamine/ai/requirements/requirement-analysis.json"
      ],
      "blockedBy": []
    },
    {
      "id": "ARCH-001",
      "role": "architecture",
      "status": "blocked",
      "task": "依据完整原子需求确定能力归属、模块边界、事务边界和技术约束",
      "allowedPaths": [
        "projects/unexamine/ai/architecture",
        "projects/unexamine/ai/planning",
        "projects/unexamine/ai/decisions"
      ],
      "inputs": [
        "projects/unexamine/ai/requirements/requirement-analysis.json"
      ],
      "outputs": [
        "projects/unexamine/ai/architecture/design.json",
        "projects/unexamine/ai/planning/task-graph.json"
      ],
      "blockedBy": ["REQ-001"]
    },
    {
      "id": "DB-001",
      "role": "database",
      "status": "blocked",
      "task": "按任务和设计完成首版表结构，运行真实 MySQL 后调用 MyBatis-Plus Generator 全量生成 base",
      "allowedPaths": [
        "projects/unexamine/db",
        "projects/unexamine/tools/base-codegen.json",
        "projects/unexamine/backend/src/main/java",
        "projects/unexamine/backend/src/main/resources/mapper"
      ],
      "inputs": [
        "projects/unexamine/ai/architecture/design.json",
        "projects/unexamine/ai/planning/task-graph.json"
      ],
      "outputs": [
        "projects/unexamine/db/base.sql",
        "projects/unexamine/db/update.sql",
        "projects/unexamine/db/all.sql",
        "projects/unexamine/db/migration",
        "projects/unexamine/backend/base-codegen-manifest.json"
      ],
      "blockedBy": ["ARCH-001"]
    },
    {
      "id": "BACKEND-001",
      "role": "backend",
      "status": "blocked",
      "task": "按周期任务在各模块 manage 包实现业务逻辑，不修改生成的 base",
      "allowedPaths": [
        "projects/unexamine/backend",
        "projects/unexamine/ai/evidence"
      ],
      "inputs": [
        "projects/unexamine/ai/planning/task-graph.json",
        "projects/unexamine/backend/base-codegen-manifest.json"
      ],
      "outputs": ["projects/unexamine/backend", "projects/unexamine/ai/evidence"],
      "blockedBy": ["DB-001"]
    },
    {
      "id": "FRONTEND-001",
      "role": "frontend",
      "status": "blocked",
      "task": "按同一周期任务实现真实页面、交互和前端测试",
      "allowedPaths": ["projects/unexamine/frontend", "projects/unexamine/ai/evidence"],
      "inputs": ["projects/unexamine/ai/planning/task-graph.json"],
      "outputs": ["projects/unexamine/frontend", "projects/unexamine/ai/evidence"],
      "blockedBy": ["ARCH-001"]
    },
    {
      "id": "TEST-001",
      "role": "test",
      "status": "blocked",
      "task": "从每个周期规划时介入，验证受影响测试、组合结果和真实入口",
      "allowedPaths": [
        "projects/unexamine/backend/src/test",
        "projects/unexamine/frontend/src",
        "projects/unexamine/ai/evidence"
      ],
      "inputs": ["projects/unexamine/ai/planning/task-graph.json"],
      "outputs": ["projects/unexamine/ai/evidence"],
      "blockedBy": ["ARCH-001"]
    },
    {
      "id": "OPS-001",
      "role": "operations",
      "status": "blocked",
      "task": "按任务实现环境、部署、升级、回滚和可观测性",
      "allowedPaths": ["projects/unexamine/deploy", "projects/unexamine/ai/evidence"],
      "inputs": ["projects/unexamine/ai/architecture/design.json", "projects/unexamine/ai/planning/task-graph.json"],
      "outputs": ["projects/unexamine/deploy", "projects/unexamine/ai/evidence"],
      "blockedBy": ["DB-001"]
    }
  ]
}
