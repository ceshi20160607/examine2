# Production credentials, APP_APPLICATION_SECRET_MASTER_KEY and APP_BOOTSTRAP_DEFAULT_ADMIN_DEPLOYMENT_KEY are intentionally absent.
# Inject them from the production secret provider; never copy development or test values here.
APP_SERVER_PORT=9999
APP_DB_URL=jdbc:mysql://production-mysql.internal:3306/unexamine?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
APP_REDIS_HOST=production-redis.internal
APP_REDIS_PORT=6379
APP_FRONTEND_HOST=127.0.0.1
APP_FRONTEND_PORT=15173
APP_FILE_STORAGE_ROOT=/srv/unexamine/data/files
APP_PREFLIGHT_ALLOW_DEVELOPMENT_DEFAULTS=false
APP_PREFLIGHT_STARTUP_ENABLED=true
APP_ENVIRONMENT_CODE=production
APP_CONFIG_VERSION=production-v1
APP_FRONTEND_SMOKE_URL=http://127.0.0.1:15173/
# Provide the relay URL and HTTPS frontend origin for password recovery; inject the relay token separately.
APP_PASSWORD_RESET_DELIVERY_MODE=WEBHOOK
APP_PASSWORD_RESET_PUBLIC_URL=https://unexamine.example.com
APP_PASSWORD_RESET_WEBHOOK_URL=https://mail-relay.example.com/password-reset
