{
  "schemaVersion": 5,
  "projectControlRoot": "projects/<project>/ai",
  "roles": [
    {"id": "lead", "owns": ["requirements ownership", "dependency graph", "delivery phases", "cycle schedule", "computed status"]},
    {"id": "pm", "owns": ["question.md", "routine product decisions", "user escalation", "decision closure"]},
    {"id": "requirements", "owns": ["atomic requirements", "use cases", "acceptance criteria"]},
    {"id": "architecture", "owns": ["module boundaries", "transaction boundaries", "data and permission boundaries"]},
    {"id": "database", "owns": ["db/init", "db/update", "db/init.sql", "db/update.sql", "db/final.sql", "indexes and constraints"]},
    {"id": "backend", "owns": ["module manage logic", "backend affected tests"]},
    {"id": "frontend", "owns": ["real pages", "frontend affected tests"]},
    {"id": "test", "owns": ["cycle test design", "cycle integration", "real entry journey"]},
    {"id": "operations", "owns": ["environment", "deployment", "upgrade", "rollback", "observability"]}
  ],
  "gates": [
    {"id": "G01_REQUIREMENTS", "ordinal": 1, "name": "full requirement analysis"},
    {"id": "G02_CAPABILITY_OWNERSHIP", "ordinal": 2, "name": "exclusive capability ownership"},
    {"id": "G03_USE_CASES_TASKS", "ordinal": 3, "name": "atomic use cases and tasks"},
    {"id": "G04_DEPENDENCY_CODE_ASSESSMENT", "ordinal": 4, "name": "dependency and current-code assessment"},
    {"id": "G05_DATABASE_DESIGN", "ordinal": 5, "name": "database design"},
    {"id": "G06_BASE_GENERATION", "ordinal": 6, "name": "MyBatis-Plus base generation"},
    {"id": "G07_MANAGE_IMPLEMENTATION", "ordinal": 7, "name": "manage business implementation"},
    {"id": "G08_FRONTEND_IMPLEMENTATION", "ordinal": 8, "name": "frontend implementation"},
    {"id": "G09_CYCLE_VERIFICATION", "ordinal": 9, "name": "cycle integration and real-entry verification"}
  ],
  "cycle": {
    "maximumMinutes": 240,
    "taskEstimate": {"maximumMinutes": 240, "noArtificialMinimum": true},
    "testParticipatesFromPlanning": true,
    "endChecks": ["one affected integration suite", "one source-bound page journey", "one real entry demonstration"]
  },
  "executionLoop": {
    "continuous": true,
    "activationIntents": ["continue development", "start implementation", "finish the project"],
    "selectNext": "lowest-order incomplete cycle whose dependencies are satisfied",
    "afterCycle": [
      "write cycle evidence",
      "recompute project status",
      "report progress without yielding control",
      "start the next eligible cycle"
    ],
    "failurePolicy": "fix the implementation or environment and rerun the affected verification",
    "stopConditions": [
      "all scheduled cycles are complete and all gates pass",
      "the user explicitly requests a stop",
      "a required action exceeds granted authority or is destructive",
      "question.md contains an unresolved decision that PM cannot close without the user"
    ],
    "forbiddenStops": [
      "one cycle is complete",
      "a test or page journey fails",
      "context compaction or token usage",
      "waiting for another generic continue command"
    ]
  },
  "deliveryPhases": {
    "separateFromGates": true,
    "computedAfter": ["atomic tasks", "dependency graph", "existing code assessment"],
    "purpose": "project-specific dependency milestones from skeleton to usable to complete"
  },
  "forbidden": [
    "treat project delivery phases as extra quality gates",
    "schedule before atomic tasks exist",
    "duplicate one capability across foundation and completion phases",
    "edit generated base code",
    "use mocks, compilation or HTTP 200 as completion evidence",
    "allow agents to set their own completion percentage",
    "yield control merely because one cycle is complete"
  ]
}
