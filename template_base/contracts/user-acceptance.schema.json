{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://template-base.local/contracts/user-acceptance.schema.json",
  "title": "Template Base explicit user acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accepted",
    "recordedBy",
    "projectId",
    "contractSha256",
    "generationManifestSha256",
    "acceptedBy",
    "acceptedAt",
    "scope"
  ],
  "properties": {
    "accepted": { "const": true },
    "recordedBy": { "const": "user" },
    "projectId": { "type": "string", "minLength": 1 },
    "contractSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "generationManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "acceptedBy": { "type": "string", "minLength": 1 },
    "acceptedAt": { "type": "string", "format": "date-time" },
    "scope": { "type": "string", "minLength": 1 }
  }
}
