{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://template-base.local/contracts/architecture-baseline.schema.json",
  "title": "Template Base Architecture Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "application", "boundaries", "firstVerticalSlice", "unresolvedDecisions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "businessModuleRealization", "identityStrategy", "tenancyStrategy"],
      "properties": {
        "kind": { "enum": ["fixed-domain-system", "runtime-configurable-platform"] },
        "businessModuleRealization": { "enum": ["compile-time-generated", "runtime-metadata"] },
        "identityStrategy": { "enum": ["application-local", "platform-unified"] },
        "tenancyStrategy": { "enum": ["single-tenant", "fixed-multi-tenant", "runtime-switchable-multi-tenant"] }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixedCore", "runtimeConfigured", "forbiddenImplementations"],
      "properties": {
        "fixedCore": { "$ref": "#/$defs/nonEmptyStringArray" },
        "runtimeConfigured": { "$ref": "#/$defs/nonEmptyStringArray" },
        "forbiddenImplementations": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "firstVerticalSlice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "orderedOutcomes", "deferredCapabilities"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "orderedOutcomes": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "deferredCapabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "unresolvedDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "blocking"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "blocking": { "const": true }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
