{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://template-base.local/contracts/requirement-scope.schema.json",
  "title": "Template Base Requirement Delivery Scope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "intake", "selectors", "deferredRationale"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "requirementsSha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "requirementsSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "selectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["includeHeadingPaths", "includeBlocks", "excludeBlocks"],
      "properties": {
        "includeHeadingPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "includeBlocks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^B[0-9]{4,}$" } },
        "excludeBlocks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^B[0-9]{4,}$" } }
      }
    },
    "deferredRationale": { "type": "string", "minLength": 1 }
  }
}
