{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://template-base.local/rules/task-catalog.schema.json",
  "title": "Source-bound atomic implementation and verification task catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "tasks"],
  "properties": {
    "schemaVersion": {"const": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecturePath", "architectureSha256", "useCaseCatalogPath", "useCaseCatalogSha256"],
      "properties": {
        "architecturePath": {"type": "string", "minLength": 1},
        "architectureSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "useCaseCatalogPath": {"type": "string", "minLength": 1},
        "useCaseCatalogSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "capabilityId", "kind", "role", "requirementIds", "useCaseIds", "outcome", "inputs", "outputs", "resources", "acceptance"],
        "properties": {
          "id": {"type": "string", "pattern": "^TASK-[0-9]{4,}$"},
          "title": {"type": "string", "minLength": 1},
          "capabilityId": {"type": "string", "pattern": "^CAP-[A-Z0-9][A-Z0-9-]*$"},
          "kind": {"enum": ["design", "database", "base-generation", "backend-manage", "frontend", "integration-test", "operations"]},
          "role": {"enum": ["lead", "pm", "requirements", "architecture", "database", "backend", "frontend", "test", "operations"]},
          "requirementIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^REQ-[A-Z0-9][A-Z0-9-]*$"}},
          "useCaseIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^UC-[A-Z0-9][A-Z0-9-]*$"}},
          "outcome": {"type": "string", "minLength": 1},
          "inputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "resources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
