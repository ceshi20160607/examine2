{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://template-base.local/rules/requirement-analysis.schema.json",
  "title": "Template Base requirement analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "requirements", "decisions", "coverage"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intakePath", "intakeSha256", "requirementsSha256"],
      "properties": {
        "intakePath": { "type": "string", "minLength": 1 },
        "intakeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "requirementsSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "fragmentIndexPath": { "type": "string", "minLength": 1 },
        "fragmentIndexSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "statement", "type", "priority", "origin", "status", "sourceBlocks", "acceptanceCriteria", "decisionIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^REQ-[A-Z0-9][A-Z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "type": { "enum": ["functional", "quality", "constraint", "non-goal"] },
          "priority": { "enum": ["must", "should", "could"] },
          "origin": { "enum": ["explicit", "proposed"] },
          "status": { "enum": ["confirmed", "pending"] },
          "sourceBlocks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^B[0-9]{4,}$" } },
          "acceptanceCriteria": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "decisionIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^DEC-[A-Z0-9][A-Z0-9-]*$" } }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "sourceBlocks", "options", "status", "resolution", "resolvedBy"],
        "properties": {
          "id": { "type": "string", "pattern": "^DEC-[A-Z0-9][A-Z0-9-]*$" },
          "question": { "type": "string", "minLength": 1 },
          "sourceBlocks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^B[0-9]{4,}$" } },
          "options": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
          "status": { "enum": ["open", "resolved"] },
          "resolution": { "type": ["string", "null"] },
          "resolvedBy": { "enum": ["user", "explicit-source", "pm", null] }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceBlock", "classification", "requirementIds", "rationale"],
        "properties": {
          "sourceBlock": { "type": "string", "pattern": "^B[0-9]{4,}$" },
          "classification": { "enum": ["requirement", "context", "duplicate", "superseded", "engineering-setting"] },
          "requirementIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "rationale": { "type": "string" }
        }
      }
    }
  }
}
