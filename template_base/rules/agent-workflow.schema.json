{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://template-base.local/rules/agent-workflow.schema.json",
  "title": "Reusable Agent workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectControlRoot", "roles", "gates", "cycle", "forbidden"],
  "properties": {
    "schemaVersion": {"const": 3},
    "projectControlRoot": {"const": "projects/<project>/ai"},
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owns"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "owns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ordinal", "name"],
        "properties": {
          "id": {"type": "string", "pattern": "^G[0-9]{2}_[A-Z0-9_]+$"},
          "ordinal": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "minLength": 1}
        }
      }
    },
    "cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumMinutes", "taskMinutes", "testParticipatesFromPlanning", "endChecks"],
      "properties": {
        "maximumMinutes": {"const": 240},
        "taskMinutes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": {"const": 10},
            "maximum": {"const": 120}
          }
        },
        "testParticipatesFromPlanning": {"const": true},
        "endChecks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "forbidden": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
