{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://template-base.local/rules/agent-workflow.schema.json",
  "title": "Reusable Agent workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectControlRoot", "roles", "gates", "cycle", "executionLoop", "deliveryPhases", "forbidden"],
  "properties": {
    "schemaVersion": {"const": 5},
    "projectControlRoot": {"const": "projects/<project>/ai"},
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owns"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "owns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ordinal", "name"],
        "properties": {
          "id": {"type": "string", "pattern": "^G[0-9]{2}_[A-Z0-9_]+$"},
          "ordinal": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "minLength": 1}
        }
      }
    },
    "cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumMinutes", "taskEstimate", "testParticipatesFromPlanning", "endChecks"],
      "properties": {
        "maximumMinutes": {"const": 240},
        "taskEstimate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maximumMinutes", "noArtificialMinimum"],
          "properties": {
            "maximumMinutes": {"const": 240},
            "noArtificialMinimum": {"const": true}
          }
        },
        "testParticipatesFromPlanning": {"const": true},
        "endChecks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "executionLoop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["continuous", "activationIntents", "selectNext", "afterCycle", "failurePolicy", "stopConditions", "forbiddenStops"],
      "properties": {
        "continuous": {"const": true},
        "activationIntents": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "selectNext": {"const": "lowest-order incomplete cycle whose dependencies are satisfied"},
        "afterCycle": {
          "type": "array",
          "prefixItems": [
            {"const": "write cycle evidence"},
            {"const": "recompute project status"},
            {"const": "report progress without yielding control"},
            {"const": "start the next eligible cycle"}
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "failurePolicy": {"const": "fix the implementation or environment and rerun the affected verification"},
        "stopConditions": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "forbiddenStops": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "deliveryPhases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["separateFromGates", "computedAfter", "purpose"],
      "properties": {
        "separateFromGates": {"const": true},
        "computedAfter": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "purpose": {"type": "string", "minLength": 1}
      }
    },
    "forbidden": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
