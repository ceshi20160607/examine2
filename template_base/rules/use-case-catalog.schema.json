{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://template-base.local/rules/use-case-catalog.schema.json",
  "title": "Source-bound atomic use-case catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "useCases"],
  "properties": {
    "schemaVersion": {"const": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementAnalysisPath", "requirementAnalysisSha256", "architecturePath", "architectureSha256"],
      "properties": {
        "requirementAnalysisPath": {"type": "string", "minLength": 1},
        "requirementAnalysisSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "architecturePath": {"type": "string", "minLength": 1},
        "architectureSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "useCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "capabilityId", "requirementIds", "actor", "entry", "preconditions", "steps", "persistentResults", "authorizationResults", "failureResults"],
        "properties": {
          "id": {"type": "string", "pattern": "^UC-[A-Z0-9][A-Z0-9-]*$"},
          "title": {"type": "string", "minLength": 1},
          "capabilityId": {"type": "string", "pattern": "^CAP-[A-Z0-9][A-Z0-9-]*$"},
          "requirementIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^REQ-[A-Z0-9][A-Z0-9-]*$"}},
          "actor": {"type": "string", "minLength": 1},
          "entry": {"type": "string", "minLength": 1},
          "preconditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["order", "action", "input", "visibleResult"],
              "properties": {
                "order": {"type": "integer", "minimum": 1},
                "action": {"type": "string", "minLength": 1},
                "input": {"type": ["string", "null"]},
                "visibleResult": {"type": "string", "minLength": 1}
              }
            }
          },
          "persistentResults": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "authorizationResults": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "failureResults": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
