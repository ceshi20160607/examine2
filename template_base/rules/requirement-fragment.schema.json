{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://template-base.local/rules/requirement-fragment.schema.json",
  "title": "Template Base bounded requirement analysis fragment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "packetId", "requirements", "decisions", "coverage"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planPath", "planSha256"],
      "properties": {
        "planPath": { "type": "string", "minLength": 1 },
        "planSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "packetId": { "type": "string", "pattern": "^RWP-[0-9]{4,}$" },
    "requirements": { "type": "array" },
    "decisions": { "type": "array" },
    "coverage": { "type": "array" }
  }
}
