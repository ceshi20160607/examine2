{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://template-base.local/rules/task-graph.schema.json",
  "title": "Assessed task dependency graph, delivery phases and four-hour cycles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "phases", "cycles", "taskSchedules", "existingImplementationAssessment"],
  "properties": {
    "schemaVersion": {"const": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskCatalogPath", "taskCatalogSha256"],
      "properties": {
        "taskCatalogPath": {"type": "string", "minLength": 1},
        "taskCatalogSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "name", "outcome", "dependsOn"],
        "properties": {
          "id": {"type": "string", "pattern": "^PHASE-[0-9]{2,}$"},
          "order": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "minLength": 1},
          "outcome": {"type": "string", "minLength": 1},
          "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^PHASE-[0-9]{2,}$"}}
        }
      }
    },
    "cycles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "phaseId", "order", "maximumMinutes", "taskIds", "journeyUseCaseIds"],
        "properties": {
          "id": {"type": "string", "pattern": "^CYCLE-[0-9]{3,}$"},
          "phaseId": {"type": "string", "pattern": "^PHASE-[0-9]{2,}$"},
          "order": {"type": "integer", "minimum": 1},
          "maximumMinutes": {"const": 240},
          "taskIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^TASK-[0-9]{4,}$"}},
          "journeyUseCaseIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^UC-[A-Z0-9][A-Z0-9-]*$"}}
        }
      }
    },
    "taskSchedules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taskId", "phaseId", "estimateMinutes", "dependsOn"],
        "properties": {
          "taskId": {"type": "string", "pattern": "^TASK-[0-9]{4,}$"},
          "phaseId": {"type": "string", "pattern": "^PHASE-[0-9]{2,}$"},
          "estimateMinutes": {"type": "integer", "minimum": 1, "maximum": 240},
          "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^TASK-[0-9]{4,}$"}}
        }
      }
    },
    "existingImplementationAssessment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "treatment", "taskIds", "rationale"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "treatment": {"enum": ["reuse", "modify", "replace", "delete"]},
          "taskIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^TASK-[0-9]{4,}$"}},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
