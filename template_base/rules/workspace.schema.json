{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://template-base.local/rules/workspace.schema.json",
  "title": "Template Base Workspace Boundary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workspaceId", "requirements", "template", "activeProject"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workspaceId": { "type": "string", "minLength": 1 },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "intake"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "intake": { "type": "string", "minLength": 1 }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "versionFile"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "versionFile": { "type": "string", "minLength": 1 }
      }
    },
    "activeProject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 }
      }
    }
  }
}
