{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/management-ui-contract-v1.json",
  "title": "Management UI contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "pageId",
    "pageKind",
    "module",
    "header",
    "toolbar",
    "table",
    "detail",
    "optionalEntries",
    "dashboard",
    "states"
  ],
  "properties": {
    "contractVersion": { "const": 1 },
    "pageId": { "type": "string", "minLength": 1 },
    "pageKind": { "const": "management-list-detail" },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "entityLabel", "requirementIds"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "entityLabel": { "type": "string", "minLength": 1 },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "titleSource", "rightActions"],
      "properties": {
        "layout": { "const": "single_row" },
        "titleSource": { "const": "module" },
        "rightActions": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/action" }
        }
      }
    },
    "toolbar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "search", "advancedFilter", "import", "export", "batchActions"],
      "properties": {
        "layout": { "enum": ["single_row", "single_row_wrap"] },
        "search": { "$ref": "#/$defs/search" },
        "advancedFilter": { "$ref": "#/$defs/advancedFilter" },
        "import": { "$ref": "#/$defs/transfer" },
        "export": { "$ref": "#/$defs/transfer" },
        "batchActions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["visibility", "actions"],
          "properties": {
            "visibility": { "const": "when_selection_nonempty" },
            "actions": {
              "type": "array",
              "items": { "$ref": "#/$defs/action" }
            }
          }
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headerVisible", "density", "selectionControl", "rowClick", "columns", "rowActions"],
      "properties": {
        "headerVisible": { "const": true },
        "density": { "enum": ["compact", "comfortable"] },
        "selectionControl": { "enum": ["checkbox", "none"] },
        "rowClick": { "const": "open_right_detail" },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 }
            }
          }
        },
        "rowActions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        }
      }
    },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "layout", "preserveListContext", "stackedSections", "relatedDataPlacement", "tabs"],
      "properties": {
        "surface": { "const": "right_drawer" },
        "layout": { "const": "tabs" },
        "preserveListContext": { "const": true },
        "stackedSections": { "const": false },
        "relatedDataPlacement": { "const": "tabs" },
        "tabs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "purpose"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "purpose": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "optionalEntries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "defaultVisible", "placement", "requirementId"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "defaultVisible": { "type": "boolean" },
          "placement": { "enum": ["absent", "more", "navigation", "row_or_detail", "detail_tab"] },
          "requirementId": { "type": ["string", "null"] }
        }
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "primaryEditor", "primarySurface", "jsonMode"],
      "properties": {
        "enabled": { "type": "boolean" },
        "primaryEditor": { "enum": ["visual_drag_resize", "not_applicable"] },
        "primarySurface": { "enum": ["visual_canvas", "not_applicable"] },
        "jsonMode": { "enum": ["advanced_optional", "disabled", "not_applicable"] }
      }
    },
    "states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loading", "empty", "error", "permissionDenied"],
      "properties": {
        "loading": { "const": true },
        "empty": { "const": true },
        "error": { "const": true },
        "permissionDenied": { "const": true }
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "purpose", "kind", "compact", "requiresSelection", "requirementId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["primary", "secondary", "danger"] },
        "compact": { "const": true },
        "requiresSelection": { "type": "boolean" },
        "requirementId": { "type": "string", "minLength": 1 }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible", "mode", "purpose"],
      "properties": {
        "visible": { "const": true },
        "mode": { "const": "fuzzy" },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "advancedFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible", "surface", "purpose"],
      "properties": {
        "visible": { "const": true },
        "surface": { "enum": ["drawer", "popover"] },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible", "placement", "compact", "requirementId"],
      "properties": {
        "visible": { "type": "boolean" },
        "placement": { "enum": ["header_right", "toolbar_right", "more", "absent"] },
        "compact": { "const": true },
        "requirementId": { "type": ["string", "null"] }
      }
    }
  }
}
