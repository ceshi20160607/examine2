{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:examine2:vs4:field-contract-schema:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "contractId", "evidenceCasePattern", "caseCatalog",
    "caseApplicabilityByMode", "caseApplicabilityByOperatorPolicy",
    "conditionalCaseApplicability", "derivedFixtureByType", "fixtureProfiles",
    "operatorVectorProfiles", "resultTypePolicies", "types", "derivedExecutionFixtures",
    "derivedCompatibilityMatrix", "migrationEdges", "migrationDefaults"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "contractId": {"const": "VS4-FIELD-RUNTIME-V2"},
    "evidenceCasePattern": {"const": "FT-{ordinal}-{type}-{case}"},
    "caseCatalog": {
      "const": [
        "SCHEMA_ACTIVATION", "CARDINALITY_MIN_MAX", "LEGAL_VECTORS", "ILLEGAL_VECTORS",
        "CREATE_READBACK", "UPDATE_READBACK", "NORMALIZATION_VECTORS", "EACH_EXPLICIT_OPERATOR",
        "RESULT_SCHEMA_OPERATOR_EXPANSION", "SORT_IF_SUPPORTED", "UNIQUE_IF_SUPPORTED", "INDEX_ROUTE",
        "FIELD_PERMISSION", "SENSITIVE_PERMISSION_AND_REDACTION", "DEPENDENCY_COMPUTE_AND_RECOMPUTE",
        "SYSTEM_COMPUTE", "DIRECT_WRITE_REJECTED", "HISTORY_AUDIT_OUTBOX", "RESTART_READBACK",
        "REQUIRED_BLOCKS_ACTIVATION", "API_WRITE_REJECTED", "UI_CONTROL_ABSENT"
      ]
    },
    "caseApplicabilityByMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["WRITABLE", "WRITABLE_TRANSITION", "SENSITIVE_WRITABLE", "DERIVED_READONLY", "SYSTEM_COMPUTED", "DEFERRED"],
      "properties": {
        "WRITABLE": {"$ref": "#/$defs/CaseArray"},
        "WRITABLE_TRANSITION": {"$ref": "#/$defs/CaseArray"},
        "SENSITIVE_WRITABLE": {"$ref": "#/$defs/CaseArray"},
        "DERIVED_READONLY": {"$ref": "#/$defs/CaseArray"},
        "SYSTEM_COMPUTED": {"$ref": "#/$defs/CaseArray"},
        "DEFERRED": {"$ref": "#/$defs/CaseArray"}
      }
    },
    "caseApplicabilityByOperatorPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["EXPLICIT", "RESULT_SCHEMA", "NONE"],
      "properties": {
        "EXPLICIT": {"const": ["EACH_EXPLICIT_OPERATOR"]},
        "RESULT_SCHEMA": {"const": ["RESULT_SCHEMA_OPERATOR_EXPANSION"]},
        "NONE": {"const": []}
      }
    },
    "conditionalCaseApplicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["NORMALIZATION_VECTORS", "SORT_IF_SUPPORTED", "UNIQUE_IF_SUPPORTED"],
      "properties": {
        "NORMALIZATION_VECTORS": {"const": "fixtureProfile.normalizationVectors.length > 0"},
        "SORT_IF_SUPPORTED": {"const": "type.sortable == true"},
        "UNIQUE_IF_SUPPORTED": {"const": "type.uniquePolicy != NONE"}
      }
    },
    "derivedFixtureByType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["REFERENCE", "FORMULA", "SUMMARY", "CALCULATED", "LOOKUP"],
      "properties": {
        "REFERENCE": {"const": "referenceDerived"},
        "FORMULA": {"const": "formulaDerived"},
        "SUMMARY": {"const": "summaryDerived"},
        "CALCULATED": {"const": "calculatedDerived"},
        "LOOKUP": {"const": "lookupDerived"}
      }
    },
    "fixtureProfiles": {
      "type": "object",
      "minProperties": 43,
      "additionalProperties": {"$ref": "#/$defs/FixtureProfile"}
    },
    "operatorVectorProfiles": {
      "type": "object",
      "minProperties": 15,
      "additionalProperties": {"$ref": "#/$defs/OperatorVectorProfile"}
    },
    "resultTypePolicies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["STRING", "DECIMAL", "INTEGER", "DATE", "DATETIME", "BOOLEAN"],
      "properties": {
        "STRING": {"$ref": "#/$defs/ResultTypePolicy"},
        "DECIMAL": {"$ref": "#/$defs/ResultTypePolicy"},
        "INTEGER": {"$ref": "#/$defs/ResultTypePolicy"},
        "DATE": {"$ref": "#/$defs/ResultTypePolicy"},
        "DATETIME": {"$ref": "#/$defs/ResultTypePolicy"},
        "BOOLEAN": {"$ref": "#/$defs/ResultTypePolicy"}
      }
    },
    "types": {"type": "array", "minItems": 49, "maxItems": 49, "uniqueItems": true, "items": {"$ref": "#/$defs/FieldType"}},
    "derivedExecutionFixtures": {"type": "array", "minItems": 30, "maxItems": 30, "items": {"$ref": "#/$defs/DerivedExecutionFixture"}},
    "derivedCompatibilityMatrix": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/DerivedCompatibility"}},
    "migrationEdges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/MigrationEdge"}},
    "migrationDefaults": {"type": "object", "minProperties": 6}
  },
  "$defs": {
    "CaseArray": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "LegalVector": {
      "type": "object", "minProperties": 1,
      "anyOf": [
        {"required": ["input"]}, {"required": ["serverExpectedPattern"]}, {"required": ["dependencyInput"]},
        {"required": ["relationFieldCode"]}, {"required": ["ast"]}, {"required": ["dependencyValues"]},
        {"required": ["serverClock"]}, {"required": ["actor"]}
      ]
    },
    "IllegalVector": {
      "type": "object", "minProperties": 1,
      "anyOf": [{"required": ["error"]}, {"required": ["expectedSanitized"]}, {"required": ["targetFieldUnreadable"]}]
    },
    "NormalizationVector": {
      "type": "object", "required": ["input"],
      "anyOf": [{"required": ["expected"]}, {"required": ["expectedCanonical"]}]
    },
    "ResultVector": {
      "type": "object", "additionalProperties": false,
      "required": ["resultSchema", "expected", "typedColumn", "operatorVectorProfile", "executionFixtureId"],
      "properties": {
        "resultSchema": {"enum": ["STRING", "DECIMAL", "INTEGER", "DATE", "DATETIME", "BOOLEAN"]},
        "expected": {},
        "typedColumn": {"enum": ["STRING", "DECIMAL", "INTEGER", "DATE", "DATETIME", "BOOLEAN"]},
        "operatorVectorProfile": {"type": "string", "minLength": 1},
        "executionFixtureId": {"type": "string", "pattern": "^DX-(REFERENCE|FORMULA|SUMMARY|CALCULATED|LOOKUP)-(STRING|DECIMAL|INTEGER|DATE|DATETIME|BOOLEAN)$"}
      }
    },
    "FixtureProfile": {
      "type": "object",
      "required": ["valueSchema", "legalVectors", "illegalVectors", "normalizationVectors"],
      "properties": {
        "valueSchema": {"type": "object", "minProperties": 1},
        "legalVectors": {"type": "array", "items": {"$ref": "#/$defs/LegalVector"}},
        "illegalVectors": {"type": "array", "items": {"$ref": "#/$defs/IllegalVector"}},
        "normalizationVectors": {"type": "array", "items": {"$ref": "#/$defs/NormalizationVector"}},
        "comparisonVectors": {"type": "array", "minItems": 2, "items": {"type": "object", "minProperties": 2}},
        "resultVectors": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/ResultVector"}},
        "recalculationVectors": {"type": "array", "minItems": 1, "items": {"type": "object", "minProperties": 2}}
      }
    },
    "OperatorVectorProfile": {
      "type": "object", "required": ["fixtureValues", "expectedByOperator"],
      "properties": {
        "fixtureValues": {"type": "array", "minItems": 1},
        "expectedByOperator": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "array", "items": {"type": "integer", "minimum": 0}}},
        "crossCurrencyPolicy": {"type": "string"}
      }
    },
    "ResultTypePolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["operators", "typedColumn", "operatorVectorProfile"],
      "properties": {
        "operators": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "typedColumn": {"enum": ["STRING", "DECIMAL", "INTEGER", "DATE", "DATETIME", "BOOLEAN"]},
        "operatorVectorProfile": {"type": "string", "minLength": 1}
      }
    },
    "IndexStrategy": {
      "type": "object", "required": ["kind", "typedColumn"],
      "properties": {
        "kind": {"enum": ["TYPED", "SEARCH_TABLE", "HMAC_EQUALITY", "MONEY_TYPED", "RELATION_TABLE", "RESULT_TYPED", "SUBTABLE_TABLE", "TYPED_WITH_EXACT_POST_FILTER", "JSON_PATH_TYPED"]},
        "typedColumn": {"type": ["string", "null"]},
        "companionColumns": {"type": "array", "items": {"enum": ["CURRENCY"]}},
        "requiresPathSnapshotId": {"type": "boolean"}
      }
    },
    "FieldType": {
      "type": "object",
      "required": ["ordinal", "type", "mode", "storage", "minCardinality", "maxCardinality", "normalizerId", "fixtureProfile", "operatorPolicy", "operators", "operatorVectorProfile", "sortable", "uniquePolicy", "indexStrategies", "selfConverterId"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 49},
        "type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "mode": {"enum": ["WRITABLE", "WRITABLE_TRANSITION", "SENSITIVE_WRITABLE", "DERIVED_READONLY", "SYSTEM_COMPUTED", "DEFERRED"]},
        "targetSlice": {"enum": ["VS5", "VS6", "VS10"]},
        "storage": {"type": "string"},
        "minCardinality": {"type": "integer", "minimum": 0},
        "maxCardinality": {"type": "integer", "minimum": 0},
        "normalizerId": {"type": "string", "minLength": 1},
        "fixtureProfile": {"type": "string", "minLength": 1},
        "operatorPolicy": {"enum": ["EXPLICIT", "RESULT_SCHEMA", "NONE"]},
        "operators": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "operatorVectorProfile": {"type": ["string", "null"]},
        "sortable": {"type": "boolean"},
        "uniquePolicy": {"enum": ["NONE", "VALUE", "ELEMENT"]},
        "indexStrategies": {"type": "array", "items": {"$ref": "#/$defs/IndexStrategy"}},
        "selfConverterId": {"type": "string", "minLength": 1}
      }
    },
    "DerivedExecutionFixture": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "fieldType", "resultSchema", "schemaConfig", "sourceRecords", "expectedMaterializedRows", "recalculationInput", "expectedOperatorHits"],
      "properties": {
        "id": {"type": "string", "pattern": "^DX-(REFERENCE|FORMULA|SUMMARY|CALCULATED|LOOKUP)-(STRING|DECIMAL|INTEGER|DATE|DATETIME|BOOLEAN)$"},
        "fieldType": {"enum": ["REFERENCE", "FORMULA", "SUMMARY", "CALCULATED", "LOOKUP"]},
        "resultSchema": {"enum": ["STRING", "DECIMAL", "INTEGER", "DATE", "DATETIME", "BOOLEAN"]},
        "schemaConfig": {"type": "object", "minProperties": 2},
        "sourceRecords": {"type": "array", "minItems": 1, "items": {"type": "object", "minProperties": 3}},
        "expectedMaterializedRows": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["recordId", "ordinal", "value"]}},
        "recalculationInput": {"type": "object", "minProperties": 2},
        "expectedOperatorHits": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "array", "items": {"type": "string"}}}
      }
    },
    "DerivedCompatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["fieldType", "rules"],
      "properties": {
        "fieldType": {"enum": ["REFERENCE", "FORMULA", "SUMMARY", "CALCULATED", "LOOKUP"]},
        "rules": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["sourceType", "operation", "resultSchemas"], "properties": {"sourceType": {"type": "string"}, "operation": {"type": "string"}, "resultSchemas": {"type": "array", "minItems": 1, "items": {"enum": ["STRING", "DECIMAL", "INTEGER", "DATE", "DATETIME", "BOOLEAN"]}}}}}
      }
    },
    "MigrationEdge": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceType", "targetType", "class", "converterId", "converterVersion", "lossy", "reversible", "reverseConverterId", "failurePolicy"],
      "properties": {
        "sourceType": {"type": "string"}, "targetType": {"type": "string"},
        "class": {"enum": ["SAFE", "MIGRATION"]}, "converterId": {"type": "string", "minLength": 1},
        "converterVersion": {"type": "integer", "minimum": 1}, "lossy": {"type": "boolean"},
        "reversible": {"type": "boolean"}, "reverseConverterId": {"type": ["string", "null"]},
        "failurePolicy": {"type": "string", "minLength": 1}
      }
    }
  }
}
